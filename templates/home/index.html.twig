{% extends 'base.html.twig' %}

{% block title %}Accueil - SoftHotel{% endblock %}

{% block body %}
    <section class="hero">
        <h1>Bienvenue sur SoftHotel</h1>
        <p>Réservez votre chambre en toute simplicité</p>

        <div class="form-row">
            <input type="date" placeholder="Date d'arrivée">
            <input type="date" placeholder="Date de départ">
            <input type="number" min="1" placeholder="Nb. de personne">
            <a href="{{ path('app_chambre_index') }}" class="btn">Rechercher</a>
        </div>
    </section>

    <section class="section">
    <h2 class="text-center">Chambres populaires</h2>

    <div class="grid-3 mt-30">
        {% for chambre in chambres %}
            <div class="card text-center">

                {% if chambre.image %}
                    <img src="{{ asset('uploads/chambres/' ~ chambre.image) }}"
                         alt="Chambre {{ chambre.numeroChambre }}"
                         style="width:100%; height:220px; object-fit:cover; border-radius:12px;">
                {% else %}
                    <div class="img-placeholder">Aucune image</div>
                {% endif %}

                <h3 class="mt-20">Chambre {{ chambre.numeroChambre }}</h3>

                <p>
                    {{ chambre.typeChambre ? chambre.typeChambre.nomType : 'Type non défini' }}
                </p>

                {% if chambre.typeChambre %}
                    <p>
                        <strong>{{ chambre.typeChambre.prixParNuit }} EURO</strong> / nuit
                    </p>
                {% endif %}

                <div class="actions mt-20" style="justify-content:center;">
                    <a href="{{ path('app_chambre_show', {'id': chambre.id}) }}" class="btn btn-light">
                        Détails
                    </a>

                    {% if chambre.disponible %}
                        <a href="{{ path('app_reservation_new', {'id': chambre.id}) }}" class="btn">
                            Réserver
                        </a>
                    {% else %}
                        <span style="color:red;">Indisponible</span>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <p>Aucune chambre trouvée.</p>
        {% endfor %}
    </div>
</section>

    <section class="section">
        <h2 class="text-center">Avis Clients</h2>
        <div class="grid-3 mt-30">
            <div class="card">
                <h3>Client 1</h3>
                <p>Excellent service et chambre très propre.</p>
            </div>
            <div class="card">
                <h3>Client 2</h3>
                <p>Réservation simple et accueil chaleureux.</p>
            </div>
            <div class="card">
                <h3>Client 3</h3>
                <p>Très bon rapport qualité-prix.</p>
            </div>
        </div>
    </section>
{% endblock %}