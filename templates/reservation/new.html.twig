{% extends 'base.html.twig' %}

{% block title %}Nouvelle réservation{% endblock %}

{% block body %}
<section class="section">
    <h1 class="text-center">Réservation</h1>

    {% if chambre is null %}
        <div class="empty-state">
            <h2>Aucune chambre sélectionnée</h2>
            <p>Veuillez choisir une chambre pour effectuer une réservation.</p>

            <a href="{{ path('app_chambre_index') }}" class="btn mt-20">
                Voir les chambres
            </a>
        </div>
    {% else %}
        <div class="card">
            <h2>Chambre {{ chambre.numeroChambre }}</h2>

            {# ici ton formulaire de réservation #}
        </div>
    {% endif %}
</section>
{% endblock %}