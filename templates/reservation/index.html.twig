{% if reservations is empty %}
    <div class="empty-state">
        <h2>Aucune réservation en cours</h2>
        <p>Vous n'avez pas encore effectué de réservation.</p>

        <a href="{{ path('app_chambre_index') }}" class="btn mt-20">
            Réserver maintenant
        </a>
    </div>
{% else %}
    <table class="table mt-30">
        <thead>
            <tr>
                <th>Id</th>
                <th>Date début</th>
                <th>Date fin</th>
                <th>Date réservation</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for reservation in reservations %}
            <tr>
                <td>{{ reservation.id }}</td>
                <td>{{ reservation.dateDebut|date('d/m/Y') }}</td>
                <td>{{ reservation.dateFin|date('d/m/Y') }}</td>
                <td>{{ reservation.dateReservation|date('d/m/Y') }}</td>
                <td>
                    {% if reservation.statut == 'Annulée' %}
                        <span style="color:red;">Annulée</span>
                    {% elseif reservation.statut == 'Payée' %}
                        <span style="color:green;">Payée</span>
                    {% else %}
                        {{ reservation.statut }}
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('app_reservation_show', {'id': reservation.id}) }}">Voir</a>
                    <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}">Modifier</a>

                    {% if reservation.statut != 'Annulée' %}
                        <form method="post"
                              action="{{ path('app_reservation_annuler', {'id': reservation.id}) }}"
                              style="display:inline;"
                              onsubmit="return confirm('Confirmer l’annulation ?');">

                            <input type="hidden" name="_token" value="{{ csrf_token('annuler' ~ reservation.id) }}">

                            <button class="btn btn-light">
                                Annuler
                            </button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}