{% extends 'base.html.twig' %}

{% block title %}Mes réservations{% endblock %}

{% block body %}
<section class="section">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-10">
        <div>
            <h1 class="section-title !text-left !mb-2">
                Mes réservations
            </h1>
            <p class="text-bordeaux/70">
                Consultez l’historique et le statut de vos réservations.
            </p>
        </div>

        <a href="{{ path('app_chambre_index') }}" class="btn btn-gold">
            Nouvelle réservation
        </a>
    </div>

    {% if reservations is empty %}
        <div class="empty-state">
            <h2>Aucune réservation en cours</h2>
            <p>Vous n'avez pas encore effectué de réservation.</p>
        </div>
    {% else %}
        <div class="overflow-x-auto">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Date début</th>
                        <th>Date fin</th>
                        <th>Réservation</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                {% for reservation in reservations %}
                    <tr>
                        <td>#{{ reservation.id }}</td>
                        <td>{{ reservation.dateDebut|date('d/m/Y') }}</td>
                        <td>{{ reservation.dateFin|date('d/m/Y') }}</td>
                        <td>{{ reservation.dateReservation|date('d/m/Y') }}</td>
                        <td>
                            {% if reservation.statut == 'Annulée' %}
                                <span class="bg-red-600 text-white px-4 py-2 rounded-full font-bold">
                                    Annulée
                                </span>
                            {% elseif reservation.statut == 'Payée' %}
                                <span class="bg-green-600 text-white px-4 py-2 rounded-full font-bold">
                                    Payée
                                </span>
                            {% else %}
                                <span class="bg-gold text-bordeaux px-4 py-2 rounded-full font-bold">
                                    {{ reservation.statut }}
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="flex flex-wrap gap-2">
                                <a href="{{ path('app_reservation_show', {'id': reservation.id}) }}"
                                   class="btn btn-secondary">
                                    Voir
                                </a>

                                {% if reservation.statut != 'Annulée' %}
                                    <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}"
                                       class="btn btn-primary">
                                        Modifier
                                    </a>

                                    <form method="post"
                                          action="{{ path('app_reservation_annuler', {'id': reservation.id}) }}"
                                          onsubmit="return confirm('Confirmer l’annulation ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('annuler' ~ reservation.id) }}">
                                        <button class="btn btn-danger">
                                            Annuler
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</section>
{% endblock %}