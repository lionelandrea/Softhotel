{% extends 'base.html.twig' %}

{% block title %}Gestion des clients{% endblock %}

{% block body %}
<section class="section">
    <h1 class="text-center">Gestion des clients</h1>

    {% if clients is empty %}
        <div class="empty-state">
            <h2>Aucun client enregistré</h2>
            <p>Commence par ajouter un nouveau client.</p>
            <a href="{{ path('admin_client_new') }}" class="btn mt-20">Ajouter un client</a>
        </div>
    {% else %}
        <div class="mb-20">
            <a href="{{ path('admin_client_new') }}" class="btn">Ajouter un client</a>
        </div>

        <table class="table mt-30">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Email</th>
                    <th>Téléphone</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for client in clients %}
                <tr>
                    <td>{{ client.id }}</td>
                    <td>{{ client.nom }}</td>
                    <td>{{ client.prenom }}</td>
                    <td>{{ client.email }}</td>
                    <td>{{ client.telephone }}</td>
                    <td>
                        <a href="{{ path('admin_client_show', {'id': client.id}) }}">Voir</a>
                        <a href="{{ path('admin_client_edit', {'id': client.id}) }}">Modifier</a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</section>
{% endblock %}