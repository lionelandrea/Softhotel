<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}SoftHotel{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {{ importmap('app') }}
</head>

<body>

<nav class="navbar">
    <div class="nav-container">
        <a href="{{ path('app_home') }}" class="logo">
            SoftHotel
        </a>

        <div class="nav-links">
            <a href="{{ path('app_home') }}" class="nav-link">Accueil</a>
            <a href="{{ path('app_chambre_index') }}" class="nav-link">Réservation</a>
            <a href="{{ path('app_about') }}" class="nav-link">À propos</a>
            <a href="{{ path('app_contact') }}" class="nav-link">Contact</a>

            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin') }}" class="btn btn-gold">
                    Dashboard
                </a>
            {% endif %}

            {% if app.user %}
                <a href="{{ path('app_logout') }}" class="btn btn-secondary">
                    Logout
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-secondary">
                    Login
                </a>
                <a href="{{ path('app_register') }}" class="btn btn-gold">
                    Sign up
                </a>
            {% endif %}
        </div>
    </div>
</nav>

<main>
    {% block body %}{% endblock %}
</main>

<footer class="footer">
    <div class="footer-grid">
        <div>
            <h3 class="footer-title">SoftHotel</h3>
            <p class="text-white/70">
                Votre solution moderne de réservation d’hôtels.
                Confort, simplicité et efficacité au cœur de notre service.
            </p>
        </div>

        <div>
            <h4 class="footer-title">Navigation</h4>
            <ul class="space-y-2">
                <li><a href="{{ path('app_home') }}" class="footer-link">Accueil</a></li>
                <li><a href="{{ path('app_chambre_index') }}" class="footer-link">Réservation</a></li>
                <li><a href="{{ path('app_about') }}" class="footer-link">À propos</a></li>
                <li><a href="{{ path('app_contact') }}" class="footer-link">Contact</a></li>
            </ul>
        </div>

        <div>
            <h4 class="footer-title">Contact</h4>
            <p class="text-white/70">Email : contact@softhotel.com</p>
            <p class="text-white/70">Tél : +237 6 99 99 99 99</p>
            <p class="text-white/70">Douala, Cameroun</p>
        </div>

        <div>
            <h4 class="footer-title">Suivez-nous</h4>
            <div class="flex flex-col gap-2">
                <a href="#" class="footer-link">Facebook</a>
                <a href="#" class="footer-link">WhatsApp</a>
                <a href="#" class="footer-link">Instagram</a>
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        © {{ "now"|date("Y") }} SoftHotel. Tous droits réservés.
    </div>
</footer>

</body>
</html>