<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}SoftHotel{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Arial, sans-serif; background: #f7f7f7; color: #222; }
        a { text-decoration: none; color: inherit; }
        .container { width: 90%; max-width: 1200px; margin: 0 auto; }
        .navbar { background: #fff; border-bottom: 1px solid #ddd; }
        .navbar .container { display: flex; justify-content: space-between; align-items: center; padding: 18px 0; }
        .logo { font-weight: bold; font-size: 22px; }
        .nav-links { display: flex; gap: 24px; align-items: center; }
        .btn { display: inline-block; padding: 10px 18px; border: 1px solid #222; background: #222; color: #fff; border-radius: 6px; }
        .btn-light { background: #fff; color: #222; }
        .hero, .section, .card, .box { background: #fff; border: 1px solid #ddd; border-radius: 10px; }
        .hero { padding: 50px 30px; margin-top: 25px; text-align: center; }
        .section { padding: 30px; margin-top: 25px; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
        .grid-2 { display: grid; grid-template-columns: 1.2fr 1fr; gap: 25px; }
        .card { padding: 18px; }
        .img-placeholder { height: 180px; background: #d9d9d9; border-radius: 8px; display: flex; justify-content: center; align-items: center; font-weight: bold; }
        .form-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-top: 25px; }
        .form-group { margin-bottom: 18px; }
        input, select { width: 100%; padding: 10px; border: 1px solid #bbb; border-radius: 6px; }
        h1, h2, h3 { margin-bottom: 15px; }
        p { line-height: 1.5; }
        .mt-20 { margin-top: 20px; }
        .mt-30 { margin-top: 30px; }
        .text-center { text-align: center; }
        .actions { display: flex; gap: 10px; flex-wrap: wrap; }
        @media (max-width: 900px) {
            .grid-3, .grid-2, .form-row { grid-template-columns: 1fr; }
            .nav-links { flex-wrap: wrap; gap: 12px; }
        }
    </style>
</head>

<body>
    <nav class="navbar">
        <div class="container">
            <a href="{{ path('app_home') }}" class="logo">SoftHotel</a>
            <div class="nav-links">
                <a href="{{ path('app_home') }}">Accueil</a>
                <a href="{{ path('app_chambre_index') }}">Réservation</a>
                <a href="{{ path('app_about') }}">À propos</a>
                <a href="{{ path('app_contact') }}">Contact</a>
                <a href="{{ path('app_login') }}" class="btn btn-light">Login</a>
                <a href="{{ path('app_register') }}" class="btn">Sign up</a>
            </div>
        </div>
    </nav>

    <div class="container">
        {% block body %}{% endblock %}
    </div>
</body>
<footer class="footer">
    <div class="container">
        <div class="footer-grid">

            <div class="footer-col">
                <h3>SoftHotel</h3>
                <p>
                    Votre solution moderne de réservation d’hôtels.
                    Confort, simplicité et efficacité au cœur de notre service.
                </p>
            </div>

            <div class="footer-col">
                <h4>Navigation</h4>
                <ul>
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li><a href="{{ path('app_about') }}">À propos</a></li>
                    <li><a href="{{ path('app_contact') }}">Contact</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Contact</h4>
                <p>Email : contact@softhotel.com</p>
                <p>Tél : +237 6 99 99 99 99</p>
                <p>Douala, Cameroun</p>
            </div>

            <div class="footer-col">
                <h4>Suivez-nous</h4>
                <div class="socials">
                    <a href="#">Facebook</a>
                    <a href="#">WhatsApp</a>
                    <a href="#">Instagram</a>
                </div>
            </div>

        </div>

        <div class="footer-bottom">
            <p>© {{ "now"|date("Y") }} SoftHotel. Tous droits réservés.</p>
        </div>
    </div>
</footer>
</html>