{% extends 'base.html.twig' %}

{% block title %}Détail chambre - SoftHotel{% endblock %}

{% block body %}
<section class="section">
    <div class="grid-2">

        {# IMAGE #}
        <div>
            {% if chambre.image %}
                <img src="{{ asset('uploads/chambres/' ~ chambre.image) }}"
                     alt="Chambre {{ chambre.numeroChambre }}"
                     style="width:100%; height:300px; object-fit:cover; border-radius:12px;">
            {% else %}
                <div class="img-placeholder" style="height:300px;">
                    Aucune image
                </div>
            {% endif %}
        </div>

        {# INFOS #}
        <div>
            <h1>Chambre {{ chambre.numeroChambre }}</h1>

            <p>
                <strong>Type :</strong>
                {{ chambre.typeChambre ? chambre.typeChambre.nomType : 'Non défini' }}
            </p>

            <p>
                <strong>Capacité :</strong>
                {{ chambre.typeChambre ? chambre.typeChambre.capaciteMax : 0 }} personnes
            </p>

            <p>
                <strong>Prix :</strong>
                {% if chambre.typeChambre %}
                    {{ chambre.typeChambre.prixParNuit|number_format(2, ',', ' ') }} €
                {% else %}
                    0 €
                {% endif %}
                / nuit
            </p>

            <div class="actions mt-30">
                <a href="{{ path('app_reservation_new', {'id': chambre.id}) }}" class="btn">
                    Réserver cette chambre
                </a>
            </div>
        </div>

    </div>
</section>
{% endblock %}