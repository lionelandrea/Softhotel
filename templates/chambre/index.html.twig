{% extends 'base.html.twig' %}

{% block body %}
<h1>Liste des chambres</h1>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Image</th>
            <th>Numéro</th>
            <th>Type</th>
            <th>Disponible</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
    {% for chambre in chambres %}
        <tr>
            <td>{{ chambre.id }}</td>

            <td>
                {% if chambre.image %}
                    <img src="{{ asset('uploads/chambres/' ~ chambre.image) }}" width="100">
                {% else %}
                    Aucune image
                {% endif %}
            </td>

            <td>{{ chambre.numeroChambre }}</td>
            <td>{{ chambre.typeChambre ? chambre.typeChambre.nomType : 'Non défini' }}</td>

            <td>
                {% if chambre.disponible %}
                    <span style="color: green;">Oui</span>
                {% else %}
                    <span style="color: red;">Non</span>
                {% endif %}
            </td>

            <td>
                <a href="{{ path('app_chambre_show', {'id': chambre.id}) }}">Voir</a>

                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_chambre_edit', {'id': chambre.id}) }}">Modifier</a>
                {% endif %}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>

{% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('app_chambre_new') }}">Ajouter une chambre</a>
{% endif %}

{% endblock %}