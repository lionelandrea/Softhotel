{% extends 'base.html.twig' %}

{% block title %}Créer un compte - SoftHotel{% endblock %}

{% block body %}
<section class="section">

    <div class="form-box">

        <h1 class="section-title !mb-4">
            Créer un compte
        </h1>

        <p class="text-center text-bordeaux/70 mb-8">
            Inscrivez-vous pour réserver facilement vos chambres.
        </p>

        {{ form_start(registrationForm) }}

            {{ form_row(registrationForm.email) }}

            {{ form_row(registrationForm.password) }}

           <button type="submit" class="btn btn-gold w-full mt-6 hover:scale-105 hover:shadow-2xl active:scale-95">
               Créer mon compte
           </button>

        {{ form_end(registrationForm) }}

        <p class="text-center mt-6 text-bordeaux/70">
            Vous avez déjà un compte ?
            <a href="{{ path('app_login') }}" class="text-gold font-bold">
                Se connecter
            </a>
        </p>

    </div>

</section>
{% endblock %}