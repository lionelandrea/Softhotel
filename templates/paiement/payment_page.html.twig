{% extends 'base.html.twig' %}

{% block title %}Paiement{% endblock %}

{% block body %}
<section class="section">
    <h1 class="text-center">Paiement de la réservation</h1>

    <div class="card">
        <h2>Résumé</h2>

        <p>Réservation : #{{ reservation.id }}</p>
        <p>Chambre : {{ reservation.chambre.numeroChambre }}</p>
        <p>Client : {{ reservation.client.nom }} {{ reservation.client.prenom }}</p>
        <p>Date d’arrivée : {{ reservation.dateDebut|date('d/m/Y') }}</p>
        <p>Date de départ : {{ reservation.dateFin|date('d/m/Y') }}</p>

        <p>
            Montant à payer :
            <strong>
                {{ reservation.montantTotal|number_format(2, ',', ' ') }} €
            </strong>
        </p>

        <div class="actions mt-20" style="display:flex; gap:12px; flex-wrap:wrap;">
            <form method="post" action="{{ path('app_paypal_create', {'id': reservation.id}) }}">
                <button type="submit" class="btn">
                    Payer avec PayPal
                </button>
            </form>

            <form method="post" action="{{ path('app_paiement_confirmer', {'id': reservation.id}) }}">
                <button type="submit" class="btn btn-light">
                    Confirmer le paiement manuel
                </button>
            </form>
        </div>
    </div>
</section>
{% endblock %}