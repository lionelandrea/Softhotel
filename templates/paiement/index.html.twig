{% extends 'base.html.twig' %}

{% block title %}Liste des paiements{% endblock %}

{% block body %}
<section class="section">
    <h1 class="text-center">Liste des paiements</h1>

    {% if paiements is empty %}
        <div class="empty-state">
            <h2>Aucun paiement enregistré</h2>
            <p>Il n'y a encore aucun paiement dans le système.</p>
        </div>
    {% else %}
        <table class="table mt-30">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Montant</th>
                    <th>Date de paiement</th>
                    <th>Réservation</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for paiement in paiements %}
                <tr>
                    <td>{{ paiement.id }}</td>
                    <td>{{ paiement.montant }}</td>
                    <td>{{ paiement.datePaiement ? paiement.datePaiement|date('d/m/Y') : '' }}</td>
                    <td>{{ paiement.reservation ? paiement.reservation.id : '' }}</td>
                    <td>
                        <a href="{{ path('app_paiement_show', {'id': paiement.id}) }}">Voir</a>
                        <a href="{{ path('app_paiement_edit', {'id': paiement.id}) }}">Modifier</a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</section>
{% endblock %}