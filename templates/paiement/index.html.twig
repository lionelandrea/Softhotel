{% extends 'base.html.twig' %}

{% block title %}Liste des paiements{% endblock %}

{% block body %}
<section class="section">
    <h1 class="text-center">Liste des paiements</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Montant</th>
                <th>Date paiement</th>
                <th>Réservation</th>
                <th>Client</th>
                <th>Statut</th>
            </tr>
        </thead>

        <tbody>
        {% for paiement in paiements %}
            <tr>
                <td>{{ paiement.id }}</td>
                <td>{{ paiement.montant|number_format(2, ',', ' ') }} €</td>
                <td>{{ paiement.datePaiement ? paiement.datePaiement|date('d/m/Y') : '' }}</td>
                <td>
                    {% if paiement.reservation %}
                        <a href="{{ path('app_reservation_show', {'id': paiement.reservation.id}) }}">
                            Réservation #{{ paiement.reservation.id }}
                        </a>
                    {% else %}
                        Aucune réservation
                    {% endif %}
                </td>
                <td>
                    {% if paiement.reservation and paiement.reservation.client %}
                        {{ paiement.reservation.client.nom }} {{ paiement.reservation.client.prenom }}
                    {% else %}
                        Non défini
                    {% endif %}
                </td>
                <td>
                    {{ paiement.reservation ? paiement.reservation.statut : 'Non défini' }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Aucun paiement trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</section>
{% endblock %}