{% extends 'base.html.twig' %}

{% block title %}Contact - SoftHotel{% endblock %}

{% block body %}

<section class="contact-hero">
    <div class="contact-hero-overlay">

        <h1>
            Contactez-<span>nous</span>
        </h1>

        <div class="gold-divider"></div>

        <p>
            Une question ? Une demande particulière ?
            Notre équipe est à votre disposition pour vous accompagner
            dans tous vos projets de réservation et de séjour.
        </p>

    </div>
</section>

<section class="contact-wrapper">

    <div class="contact-grid">

        <!-- INFORMATIONS -->
        <div class="contact-info">

            <div class="contact-card">
                <div class="contact-icon">
                    ✉
                </div>

                <div>
                    <h3>Email</h3>
                    <p>contact@softhotel.com</p>
                </div>
            </div>

            <div class="contact-card">
                <div class="contact-icon">
                    ☎
                </div>

                <div>
                    <h3>Téléphone</h3>
                    <p>+237 6 99 99 99 99</p>
                </div>
            </div>

            <div class="contact-card">
                <div class="contact-icon">
                    ⌖
                </div>

                <div>
                    <h3>Adresse</h3>
                    <p>Douala, Cameroun</p>
                </div>
            </div>

            <div class="contact-card">
                <div class="contact-icon">
                    ◷
                </div>

                <div>
                    <h3>Horaires</h3>
                    <p>
                        Lundi - Dimanche <br>
                        07h00 - 22h00
                    </p>
                </div>
            </div>

        </div>

        <!-- FORMULAIRE -->
        <div class="contact-form-card">

            <h2>Envoyez-nous un message</h2>

            <form>

                <div class="form-two">

                    <div>
                        <label>Nom complet *</label>

                        <input
                            type="text"
                            placeholder="Votre nom complet"
                        >
                    </div>

                    <div>
                        <label>Email *</label>

                        <input
                            type="email"
                            placeholder="Votre adresse email"
                        >
                    </div>

                </div>

                <label>Sujet *</label>

                <input
                    type="text"
                    placeholder="Sujet du message"
                >

                <label>Message *</label>

                <textarea
                    rows="6"
                    placeholder="Écrivez votre message ici..."
                ></textarea>

                <button
                    type="submit"
                    class="contact-submit"
                >
                    ✈ Envoyer le message
                </button>

            </form>

        </div>

    </div>

</section>

{% endblock %}